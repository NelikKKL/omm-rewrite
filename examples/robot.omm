// Робот: тело, голова и «антенна» в одной группе.
mono(
  x(0) y(40) scale(1)     // сдвиг всей группы вниз

  cube3 : 1.5             // туловище
  color(80, 140, 255)
  scale(1.4)

  sphere3                 // голова
  color(255, 200, 0)
  y(-95)
  scale(0.8)

  cylinder3               // антенна
  color(220, 60, 60)
  y(-175)
  scale(0.18)
  ud(60)                  // вытянута вниз
)

// пирамида ездит вверх-вниз рядом с роботом
pyramid3
x(190) y(60)
color(120, 220, 140)
animation(y60, y-60, y60)

// плита-подставка
cube3 : 8
y(150)
scale(5)
color(70, 70, 80)
